# CAIOS Environment Configuration
PORT_ORCHESTRATOR=8000
PORT_DASHBOARD=3000
PORT_SANDBOX=8001

# LLM Sandbox Settings
LLM_PROVIDER=ollama # Options: ollama, gemini, openai, mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud API Fallbacks (optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sandboxing & Safety
SANDBOX_PATH=./sandbox
ACTIONS_LOG_PATH=./data/actions.log
DATABASE_PATH=./data/caios.db
KILL_SWITCH_DEFAULT=false
